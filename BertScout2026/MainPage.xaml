                            />

                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Editor
                            x:Name="Comments"
                            TextChanged="Comments_TextChanged"
                            HorizontalOptions="FillAndExpand"
                            HorizontalTextAlignment="Start"
                            HeightRequest="150"
