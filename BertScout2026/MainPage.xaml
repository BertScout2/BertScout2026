                </HorizontalStackLayout> -->


                <HorizontalStackLayout
                    HorizontalOptions="Start"
                    Margin="0,10,0,0"
                    >

                    <Label
                        Text="Score:"
                        HorizontalTextAlignment="Center"
                        WidthRequest="245"
                        Style="{StaticResource SubHeadline}"
                        FontSize="{OnPlatform WinUI=Small, Android=Medium}"
                        />

                    <Button
                        x:Name="ScoreStar0"
                        Text="0"
                        Clicked="ScoreStar0Clicked"
                        Margin="0,0,0,0"
                        BackgroundColor="LightGray"
                        WidthRequest="50"
                        HorizontalOptions="Center" />

                    <Button
                        x:Name="ScoreStar1"
                        Text="1"
                        Clicked="ScoreStar1Clicked"
                        Margin="5,0,0,0"
                        BackgroundColor="LightGray"
                        WidthRequest="50"
                        HorizontalOptions="Center" />

                    <Button
                        x:Name="ScoreStar2"
                        Text="2"
                        Clicked="ScoreStar2Clicked"
                        Margin="5,0,0,0"
                        BackgroundColor="LightGray"
                        WidthRequest="50"
                        HorizontalOptions="Center" />

                    <Button
                        x:Name="ScoreStar3"
                        Text="3"
                        Clicked="ScoreStar3Clicked"
                        Margin="5,0,0,0"
                        BackgroundColor="LightGray"
                        WidthRequest="50"
                        HorizontalOptions="Center" />

                    <Button
                        x:Name="ScoreStar4"
                        Text="4"
                        Clicked="ScoreStar4Clicked"
                        Margin="5,0,0,0"
                        BackgroundColor="LightGray"
                        WidthRequest="50"
                        HorizontalOptions="Center" />

                    <Button
                        x:Name="ScoreStar5"
                        Text="5"
                        Clicked="ScoreStar5Clicked"
                        Margin="5,0,0,0"
                        BackgroundColor="LightGray"
                        WidthRequest="50"
                        HorizontalOptions="Center" />

                </HorizontalStackLayout>
                <Grid>
                    <HorizontalStackLayout
                        HorizontalOptions="Center">
                        <Label
                            Text="Select some comments:"
                        />
                        <Picker
                        x:Name="CommentPicker"
                        SelectedIndexChanged="CommentPicker_SelectedIndexChanged"
                        HeightRequest="32"
                        WidthRequest="200"
                        Margin="10,0,0,0"
                        FontSize="{OnPlatform WinUI=Small, Android=Medium}"
                        />
                    </HorizontalStackLayout>
                </Grid>
                <Grid
                    HorizontalOptions="Fill"
                    >

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Editor
                        x:Name="Comments"
                        Grid.Row="0"
                        Placeholder="Put in comments"
                        PlaceholderColor="LightGray"
                        HorizontalOptions="Fill"
                        MaxLength="250"
                        Margin="10,5,10,100"
                        Text=""
                        IsEnabled="true"
                        FontSize="{OnPlatform WinUI=Small, Android=Medium}"
                        TextChanged="Comments_TextChanged"
                        />

                </Grid>

            </VerticalStackLayout>

            <VerticalStackLayout
                x:Name="ErrorLayout"
                IsVisible="False"
                Grid.Row="2"
                Padding="30,0"
            >

                <Label
                    x:Name="ErrorMsg"
                    Text="ERROR"
                    TextColor="Red"
                    FontSize="{OnPlatform WinUI=Small, Android=Medium}"
                />

            </VerticalStackLayout>

        </Grid>

    </ScrollView>

</ContentPage>
