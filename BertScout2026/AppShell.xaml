<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:DataType="Shell"
    x:Class="BertScout2026.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BertScout2026"
    Shell.FlyoutBehavior="Flyout"
    Title="BertScout2026">

    <FlyoutItem Title="Stand Scouting">
        <Tab>
            <ShellContent
                Title="Stand Scouting"
                ContentTemplate="{DataTemplate local:MainPage}"
                />
        </Tab>
    </FlyoutItem>

    <FlyoutItem Title="Match Schedule">
        <Tab>
            <ShellContent
                Title="Match Schedule"
                ContentTemplate="{DataTemplate local:MatchSchedulePage}"
                />
        </Tab>    
    </FlyoutItem>
    
    <FlyoutItem Title="Airtable">
        <Tab>
            <ShellContent
                Title="Airtable"
                ContentTemplate="{DataTemplate local:AirtablePage}"
                />
        </Tab>
    </FlyoutItem>
    
</Shell>
